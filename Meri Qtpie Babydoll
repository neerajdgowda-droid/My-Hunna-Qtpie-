<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For My Qtpiee 💗</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #ffeef8 0%, #ffd1eb 100%);
            color: #4a4a4a;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
            text-align: center;
            padding: 20px;
        }

        /* Music Controls */
        .music-box {
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.8);
            padding: 10px 15px;
            border-radius: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .music-btn {
            background: #ff65a3;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 15px;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
        }

        /* Slides Container */
        .slide-container {
            position: relative;
            width: 100%;
            max-width: 500px;
            height: 450px;
            background: white;
            border-radius: 30px;
            box-shadow: 0 10px 25px rgba(255, 101, 163, 0.2);
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .slide {
            display: none;
            width: 100%;
            height: 100%;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.5s ease-in-out;
        }

        .slide.active {
            display: flex;
        }

        /* Elements inside slides */
        h1 {
            color: #d63384;
            font-size: 28px;
            margin-bottom: 15px;
        }

        p {
            font-size: 18px;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .photo-placeholder {
            width: 180px;
            height: 180px;
            background: #fff0f6;
            border: 2px dashed #ff65a3;
            border-radius: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            color: #ff65a3;
            font-size: 14px;
            overflow: hidden;
        }

        .photo-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Next Page / Action Buttons */
        .next-btn {
            background: #ff65a3;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 101, 163, 0.3);
            transition: 0.2s;
        }

        .next-btn:hover {
            background: #e04d8b;
            transform: scale(1.05);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <!-- Music Settings Box -->
    <div class="music-box">
        <span>🎵 Song:</span>
        <button class="music-btn" onclick="toggleMusic()">Play</button>
    </div>

    <!-- Background Audio Link (Replace URL with your own song link if needed) -->
    <audio id="bg-music" loop src="https://soundhelix.com"></audio>

    <!-- Main Slide Show -->
    <div class="slide-container">
        
        <!-- Slide 1 -->
        <div class="slide active">
            <h1>Hey Hunna 💗🫶</h1>
            <p>I made something special just for you. Click below to see it...</p>
            <button class="next-btn" onclick="nextSlide()">Click Here 💖</button>
        </div>

        <!-- Slide 2 -->
        <div class="slide">
            <h1>My Qtpiee</h1>
            <div class="photo-placeholder" id="img-slot-1"><span>[Photo 1 Placeholder]</span></div>
            <p>You look so beautiful always. Just wanted to remind you today.</p>
            <button class="next-btn" onclick="nextSlide()">Next ➡️</button>
        </div>

        <!-- Slide 3 -->
        <div class="slide">
            <h1>Babydoll 💗</h1>
            <div class="photo-placeholder" id="img-slot-2"><span>[Photo 2 Placeholder]</span></div>
            <p>Every single moment thinking about you makes me smile.</p>
            <button class="next-btn" onclick="nextSlide()">Next ➡️</button>
        </div>

        <!-- Slide 4 -->
        <div class="slide">
            <h1>My Qt Punjaban 💗💗</h1>
            <div class="photo-placeholder" id="img-slot-3"><span>[Photo 3 Placeholder]</span></div>
            <p>You mean the absolute world to me, my favorite person.</p>
            <button class="next-btn" onclick="nextSlide()">Next ➡️</button>
        </div>

        <!-- Slide 5 -->
        <div class="slide">
            <h1>For my Doctor Jiii 🩺</h1>
            <p>I lovee you soo muchhh qtpiee doctor jiii</p>
            <button class="next-btn" onclick="nextSlide()">Next ➡️</button>
        </div>

        <!-- Slide 6 -->
        <div class="slide">
            <h1>Maaf Kardoo Babydolll</h1>
            <p>I am really sorry for making you upset. Please clear your mood 🥺</p>
            <button class="next-btn" onclick="nextSlide()">Next ➡️</button>
        </div>

        <!-- Slide 7 -->
        <div class="slide">
            <h1>My Promise 🤝</h1>
            <p>i’ll bot repeat it again hunnna maaf kardooo ilysm 💗🫶🥺</p>
            <button class="next-btn" onclick="nextSlide()">Next ➡️</button>
        </div>

        <!-- Slide 8 -->
        <div class="slide">
            <h1>Forever Yours ♾️</h1>
            <p>Thank you for checking this out. I love you the most! 💗</p>
            <button class="next-btn" onclick="restartSlides()">Start Over 🔄</button>
        </div>

    </div>

    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const audio = document.getElementById('bg-music');
        const musicBtn = document.querySelector('.music-btn');

        function showSlide(index) {
            slides[currentSlide].classList.remove('active');
            currentSlide = index;
            slides[currentSlide].classList.add('active');
        }

        function nextSlide() {
            if (currentSlide < slides.length - 1) {
                showSlide(currentSlide + 1);
            }
        }

        function restartSlides() {
            showSlide(0);
        }

        function toggleMusic() {
            if (audio.paused) {
                audio.play();
                musicBtn.innerText = "Pause";
            } else {
                audio.pause();
                musicBtn.innerText = "Play";
            }
        }
    </script>
</body>
</html>
